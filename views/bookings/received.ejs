<% layout("layouts/boilerplate") %>

<div class="container py-4">
    <h2 class="mb-4 fw-bold"><i class="fa-solid fa-hotel text-danger me-2"></i>Received Reservations</h2>

    <% 
      let totalEarnings = 0;
      let totalGuests = 0;
      if (bookings && bookings.length > 0) {
          for (let booking of bookings) {
              if (booking.listing) {
                  totalEarnings += booking.totalPrice;
                  totalGuests += booking.guests;
              }
          }
      }
    %>

    <% if (bookings && bookings.length > 0) { %>
        <!-- Summary Stats Section -->
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-light-subtle border-start border-danger border-4">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="bg-danger-subtle text-danger rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fa-solid fa-calendar-check fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-secondary mb-1">Total Reservations</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= bookings.length %></h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-light-subtle border-start border-success border-4">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="bg-success-subtle text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fa-solid fa-wallet fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-secondary mb-1">Total Earnings</h6>
                            <h3 class="fw-bold mb-0 text-dark">&#8377; <%= totalEarnings.toLocaleString("en-IN") %></h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-light-subtle border-start border-info border-4">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="bg-info-subtle text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="fa-solid fa-users fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-secondary mb-1">Total Guests Hosted</h6>
                            <h3 class="fw-bold mb-0 text-dark"><%= totalGuests %></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 g-4">
            <% for (let booking of bookings) { %>
                <% if (booking.listing) { %>
                    <% 
                      const checkIn = new Date(booking.checkIn);
                      const checkOut = new Date(booking.checkOut);
                      const diffTime = Math.abs(checkOut - checkIn);
                      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
                    %>
                    <div class="col">
                        <div class="card h-100 shadow-sm border rounded-4 overflow-hidden" style="transition: transform 0.2s ease;">
                            <div class="row g-0 h-100">
                                <!-- Listing Image & Label -->
                                <div class="col-md-5 position-relative" style="min-height: 200px;">
                                    <img src="<%= booking.listing.image.url %>" class="img-fluid w-100 h-100" alt="<%= booking.listing.title %>" style="object-fit: cover; position: absolute; top:0; left:0;">
                                    <span class="badge bg-danger position-absolute top-3 start-3 shadow-sm border border-light">Owner View</span>
                                </div>
                                
                                <!-- Booking & Guest Details -->
                                <div class="col-md-7 d-flex flex-column">
                                    <div class="card-body p-4 flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="card-title fw-bold text-truncate mb-0" style="max-width: 180px;">
                                                <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark hover-theme-color">
                                                    <%= booking.listing.title %>
                                                </a>
                                            </h5>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded">Confirmed</span>
                                        </div>
                                        <p class="text-muted small mb-3"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.location %>, <%= booking.listing.country %></p>
                                        
                                        <!-- Guest Info Box -->
                                        <div class="bg-light p-3 rounded-3 mb-3 border-0">
                                            <div class="small text-secondary mb-1 fw-bold"><i class="fa-solid fa-user-tie me-1"></i>GUEST INFO</div>
                                            <div class="fw-semibold text-dark"><%= booking.user ? booking.user.username : 'Unknown Guest' %></div>
                                            <% if (booking.user && booking.user.email) { %>
                                                <div class="text-muted small text-truncate"><%= booking.user.email %></div>
                                            <% } %>
                                        </div>

                                        <!-- Dates & Guests -->
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-1" style="font-size: 0.9rem;">
                                                <span class="text-secondary">Check-in:</span>
                                                <span class="fw-semibold text-dark"><%= checkIn.toLocaleDateString("en-IN", { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1" style="font-size: 0.9rem;">
                                                <span class="text-secondary">Checkout:</span>
                                                <span class="fw-semibold text-dark"><%= checkOut.toLocaleDateString("en-IN", { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1" style="font-size: 0.9rem;">
                                                <span class="text-secondary">Nights:</span>
                                                <span class="fw-semibold text-dark"><%= diffDays %> <%= diffDays > 1 ? 'nights' : 'night' %></span>
                                            </div>
                                            <div class="d-flex justify-content-between" style="font-size: 0.9rem;">
                                                <span class="text-secondary">Guests:</span>
                                                <span class="fw-semibold text-dark"><%= booking.guests %> <%= booking.guests > 1 ? 'guests' : 'guest' %></span>
                                            </div>
                                        </div>

                                        <!-- Price -->
                                        <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Total Payout:</span>
                                            <span class="fs-5 fw-bold text-success">&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></span>
                                        </div>
                                    </div>
                                    
                                    <!-- Contact Guest Footer Action -->
                                    <% if (booking.user && booking.user.email) { %>
                                        <div class="px-4 pb-4 bg-transparent border-0 pt-0">
                                            <a href="mailto:<%= booking.user.email %>?subject=Regarding your booking at <%= encodeURIComponent(booking.listing.title) %>" class="btn btn-outline-dark w-100 rounded-3 py-2 fw-semibold" style="font-size: 0.9rem;">
                                                <i class="fa-solid fa-envelope me-2"></i>Contact Guest
                                            </a>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } %>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="text-center py-5 my-5 border rounded-4 bg-light shadow-sm px-4">
            <div class="text-muted mb-3">
                <i class="fa-solid fa-hotel" style="font-size: 4rem; color: #ccc;"></i>
            </div>
            <h4 class="fw-bold mb-2">No bookings received yet!</h4>
            <p class="text-secondary mb-4 mx-auto" style="max-width: 400px;">When guests book your listed properties, their reservation details, host earnings, and contact info will appear here.</p>
            <a href="/listings/new" class="btn btn-form-action px-4 py-2" style="width: auto;">List Another Property</a>
        </div>
    <% } %>
</div>
